# REBS HRMS Environment Configuration Example
# Copy this file to .env or pass these as --dart-define flags when running/building:
# Example: flutter run --dart-define=API_BASE_URL=https://example.ngrok-free.app

# API & Server Configuration
API_BASE_URL=https://your-ngrok-or-local-url.ngrok-free.app
REQUEST_TIMEOUT_SECONDS=10

# Office Location & Geofence (Coordinates & Radius in meters)
OFFICE_LAT=12.971598
OFFICE_LNG=77.594562
OFFICE_RADIUS_METERS=200

# Company Timezone (IANA Timezone Name)
COMPANY_TIMEZONE=Asia/Kolkata

# Optional location simulation overrides for testing outside/inside geofence
MOCK_LAT=
MOCK_LNG=
